private void btnImportCsv_Click(object sender, EventArgs e)
{
    try
    {
        using (var ofd = new OpenFileDialog { Filter = "CSV files (*.csv)|*.csv" })
        {
            if (ofd.ShowDialog() == DialogResult.OK)
            {
                var lines = File.ReadAllLines(ofd.FileName).Skip(1); // Izlaižam galveni
                using (var context = new MebeluveikalsDbContext())
                {
                    foreach (var line in lines)
                    {
                        var values = line.Split(',');
                        if (values.Length == 4)
                        {
                            var id = int.Parse(values[0]);
                            var name = values[1];
                            var description = values[2];
                            var price = decimal.Parse(values[3]);

                            var existingFurniture = context.Furnitures.SingleOrDefault(f => f.Id == id);
                            if (existingFurniture != null)
                            {
                                // Atjauninām esošo ierakstu
                                existingFurniture.Name = name;
                                existingFurniture.Description = description;
                                existingFurniture.Price = price;
                            }
                            else
                            {
                                // Pievienojam jaunu ierakstu
                                var newFurniture = new Furniture
                                {
                                    Id = id,
                                    Name = name,
                                    Description = description,
                                    Price = price
                                };
                                context.Furnitures.Add(newFurniture);
                            }
                        }
                    }
                    context.SaveChanges();
                }
                MessageBox.Show("Dati veiksmīgi importēti.", "Imports pabeigts", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }
    }
    catch (Exception ex)
    {
        MessageBox.Show($"Kļūda importējot datus: {ex.Message}", "Kļūda", MessageBoxButtons.OK, MessageBoxIcon.Error);
    }
}
